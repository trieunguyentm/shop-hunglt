# ============================================================================
#  Cấu hình TRIỂN KHAI (docker compose + run.sh) — copy thành code/.env
#  Máy cá nhân: KHÔNG cần file này (mặc định chạy localhost:3000).
#  Đổi APP_URL/AUTH_PUBLIC_URL sau khi đã chạy → cần ./run.sh reset -y (Keycloak chỉ import realm lần đầu).
# ============================================================================

# --- URL công khai (domain thật, có https nếu đứng sau Nginx/Cloudflare) ---
APP_URL=https://shop.example.com
API_PUBLIC_URL=https://api.shop.example.com/api
AUTH_PUBLIC_URL=https://auth.shop.example.com

# --- Cổng publish trên máy chủ (Nginx proxy_pass tới các cổng này) ---
APP_PORT=3100
API_PORT=4100
KC_PORT=8180
DB_PORT=5532
# Chỉ mở cổng cho localhost — truy cập từ ngoài đi qua Nginx
BIND_ADDR=127.0.0.1

# --- Mật khẩu admin Keycloak (áp dụng ở lần khởi tạo đầu tiên) ---
KC_ADMIN_PASSWORD=admin

# --- Đăng nhập Google (tùy chọn) — run.sh tự cấu hình khi có đủ 2 giá trị ---
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorized redirect URI:  <AUTH_PUBLIC_URL>/realms/fashion-shop/broker/google/endpoint
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# PayOS: điền trong backend/.env.prod (PAYOS_CLIENT_ID, PAYOS_API_KEY, PAYOS_CHECKSUM_KEY)
