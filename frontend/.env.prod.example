# Mẫu cấu hình frontend cho Docker Compose. Copy thành .env.prod.
NODE_ENV=production
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# Sinh secret: openssl rand -hex 32
AUTH_SECRET=thay_bang_secret_ngau_nhien

AUTH_KEYCLOAK_ID=fashion-frontend
# Lấy ở Keycloak: Clients → fashion-frontend → Credentials
AUTH_KEYCLOAK_SECRET=lay_tu_keycloak
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/fashion-shop
# Server-side (container) gọi Keycloak nội bộ; browser vẫn dùng issuer localhost
KEYCLOAK_INTERNAL_URL=http://keycloak:8080

# API: server-side gọi nội bộ; browser gọi localhost (nướng lúc build qua ARG)
API_INTERNAL_URL=http://backend:4000/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api
