# Mẫu cấu hình backend cho Docker Compose. Copy thành .env.prod và điền PayOS nếu cần.
NODE_ENV=production
PORT=4000
CORS_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/fashion_shop?schema=public

# Keycloak: iss = localhost (khớp token trình duyệt); JWKS/Admin gọi qua Docker network
KEYCLOAK_ISSUER=http://localhost:8080/realms/fashion-shop
KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/fashion-shop/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=fashion-api
KEYCLOAK_BASE_URL=http://keycloak:8080
KEYCLOAK_REALM=fashion-shop
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

FRONTEND_URL=http://localhost:3000

# PayOS (tùy chọn) — lấy key tại https://my.payos.vn
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
