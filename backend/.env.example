# ===== Server =====
NODE_ENV=development
PORT=4000
# URL của frontend để cấu hình CORS (cách nhau bằng dấu phẩy nếu nhiều origin)
CORS_ORIGIN=http://localhost:3000

# ===== Database (PostgreSQL) =====
# Cú pháp: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fashion_shop?schema=public"

# ===== Keycloak — Resource Server (xác thực access token) =====
KEYCLOAK_ISSUER=http://localhost:8080/realms/fashion-shop
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/fashion-shop/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=fashion-api

# ===== Keycloak — Admin API (đăng ký & đồng bộ user phía backend) =====
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=fashion-shop
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ===== Seed =====
SEED_ADMIN_EMAIL=admin@fashion.local

# ===== Frontend URL (returnUrl/cancelUrl PayOS) =====
FRONTEND_URL=http://localhost:3000

# ===== PayOS (cổng thanh toán VN) — lấy key tại https://my.payos.vn =====
# Để trống → thanh toán online tắt, chỉ dùng COD.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
